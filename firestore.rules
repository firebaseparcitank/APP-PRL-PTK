rules_version = '2';

// Reglas de prueba (datos inventados): cualquiera con la app puede leer y escribir
// los permisos y los ajustes, pero solo hasta la fecha de abajo.
// Después, la base de datos se cierra sola. Para alargarla, cambiar la fecha y volver a publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function abierta() {
      return request.time < timestamp.date(2026, 11, 15);
    }

    match /permisos/{id} {
      allow read, write: if abierta();
    }

    match /ajustes/{id} {
      allow read, write: if abierta();
    }
  }
}
